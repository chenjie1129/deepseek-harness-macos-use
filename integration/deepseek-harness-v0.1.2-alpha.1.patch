+      "description": "Snapshot-scoped element token."
+    },
+    "x": {
+      "type": "number",
+      "description": "Absolute screen x when element is omitted."
+    },
+    "y": {
+      "type": "number",
+      "description": "Absolute screen y when element is omitted."
+    }
+  }
+}
+```
+
+来源：[`packages/macos-use/tool-macos-use/src/index.ts`](../packages/macos-use/tool-macos-use/src/index.ts)
+
+### `computer_open_app`
+
+根据名称启动 macOS 应用或将其置于前台，例如 "Safari" 或 "Notes"。
+
+```json
+{
+  "type": "object",
+  "properties": {
+    "name": {
+      "type": "string",
+      "description": "Application name as `open -a` resolves it."
+    }
+  },
+  "required": [
+    "name"
+  ]
+}
+```
+
+来源：[`packages/macos-use/tool-macos-use/src/index.ts`](../packages/macos-use/tool-macos-use/src/index.ts)
+
+### `computer_run_applescript`
+
+通过 `osascript` 运行任意 AppleScript，以完成其他 computer_* 工具未直接覆盖的 macOS 自动化，例如读取窗口标题或控制特定应用自身的脚本字典。
+
+```json
+{
+  "type": "object",
+  "properties": {
+    "script": {
+      "type": "string",
+      "description": "Complete AppleScript source."
+    }
+  },
+  "required": [
+    "script"
+  ]
+}
+```
+
+来源：[`packages/macos-use/tool-macos-use/src/index.ts`](../packages/macos-use/tool-macos-use/src/index.ts)
+
+### `computer_screenshot`
+
+捕获当前 macOS 屏幕。属于视觉截图排除列表中应用的窗口会被遮盖。
+
+```json
+{
+  "type": "object",
+  "properties": {}
+}
+```
+
+来源：[`packages/macos-use/tool-macos-use/src/index.ts`](../packages/macos-use/tool-macos-use/src/index.ts)
+
+### `computer_screenshot_window`
+
+捕获一个策略允许的精确窗口。对于敏感的截图排除应用，该操作会拒绝执行。
+
+```json
+{
+  "type": "object",
+  "properties": {
+    "window_id": {
+      "type": "integer",
+      "description": "CoreGraphics window id from computer_list_windows."
+    },
+    "app": {
+      "type": "string",
+      "description": "Application name when window_id is omitted."
+    },
+    "title": {
+      "type": "string",
+      "description": "Exact window title when selecting by app."
+    }
+  }
+}
+```
+
+来源：[`packages/macos-use/tool-macos-use/src/index.ts`](../packages/macos-use/tool-macos-use/src/index.ts)
+
+### `computer_scroll`
+
+滚动前台应用；可以先聚焦一个新鲜的语义元素令牌。
+
+```json
+{
+  "type": "object",
+  "properties": {
+    "direction": {
+      "type": "string",
+      "enum": [
+        "up",
+        "down",
+        "left",
+        "right"
+      ]
+    },
+    "amount": {
+      "type": "integer",
+      "description": "Bounded scroll step count; defaults to 5."
+    },
+    "element": {
+      "type": "string",
+      "description": "Optional token to focus before scrolling."
+    }
+  },
+  "required": [
+    "direction"
+  ]
+}
+```
+
+来源：[`packages/macos-use/tool-macos-use/src/index.ts`](../packages/macos-use/tool-macos-use/src/index.ts)
+
+### `computer_type`
+
+向当前聚焦的 macOS 元素输入字面文本；可以先聚焦一个新鲜的语义元素令牌。
+
+```json
+{
+  "type": "object",
+  "properties": {
+    "text": {
+      "type": "string",
+      "description": "Text to type."
+    },
+    "element": {
+      "type": "string",
+      "description": "Optional token from computer_get_window_state to focus before typing."
+    }
+  },
+  "required": [
+    "text"
+  ]
+}
+```
+
+来源：[`packages/macos-use/tool-macos-use/src/index.ts`](../packages/macos-use/tool-macos-use/src/index.ts)
+
+### `computer_use_task`
+
+自主操作 macOS 桌面以完成任务：反复截取屏幕、询问已配置的 GUI 模型下一步应在哪里点击、输入或按键，然后执行该动作，直到模型报告任务完成或步骤预算耗尽。开放式桌面任务应使用此工具；对于一个具体且已知的操作，请优先使用基础 computer_* 工具。
+
+```json
+{
+  "type": "object",
+  "properties": {
+    "task": {
+      "type": "string",
+      "description": "The task to accomplish on the desktop, in natural language."
+    },
+    "max_steps": {
+      "type": "integer",
+      "description": "Step budget before giving up. Defaults to 20 unless changed visually."
+    }
+  },
+  "required": [
+    "task"
+  ]
+}
+```
+
+来源：[`packages/macos-use/tool-macos-use/src/index.ts`](../packages/macos-use/tool-macos-use/src/index.ts)
+
+基础桌面与浏览器工具直接通过其能力 seam 执行。computer_use_task 和 browser_use_task 每个步骤都会调用一次单独配置的 GUI 视觉模型。启用的步骤截图是持久工具结果元数据，仅由客户端渲染；驱动模型接收文本任务结果。
+
